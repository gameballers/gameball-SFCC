<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="Gameball_Enabled">
                <display-name xml:lang="x-default">Enable Gameball</display-name>
                <description xml:lang="x-default">Turn the Gameball Integration on or off.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="Gameball_API_Key">
                <display-name xml:lang="x-default">Gameball API Key</display-name>
                <description xml:lang="x-default">Your unique Gameball API Key from the Dashboard.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="Gameball">
                <display-name xml:lang="x-default">Gameball Settings</display-name>
                <attribute attribute-id="Gameball_Enabled"/>
                <attribute attribute-id="Gameball_API_Key"/>
            </attribute-group>
        </group-definitions>
    </type-extension>
</metadata>
