<?xml version="1.0" encoding="UTF-8"?>
<jobs xmlns="http://www.demandware.com/xml/impex/jobs/2015-07-01">
    <job job-id="Gameball Customer Delta" priority="0">
        <description>Sweeps customer profiles changed since the last run and upserts the changed ones to Gameball. This is the only coverage for Business Manager profile edits and customer import jobs, which fire no hook, and it is also the retry path for any customer sync that failed inline. The trigger ships DISABLED and the context site-id below is a placeholder that must be changed before the job is enabled.</description>
        <parameters/>
        <flow>
            <context site-id="RefArch"/>
            <step step-id="GB-CustomerDelta" type="custom.Gameball.CustomerDelta" enforce-restart="false">
                <description/>
                <parameters/>
                <rules/>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-recurring enabled="false">
                <recurrence>
                    <date-from>2026-01-01Z</date-from>
                    <start-time>00:10:00.000Z</start-time>
                    <interval>1h</interval>
                    <day-of-week>
                        <weekday>Monday</weekday>
                        <weekday>Tuesday</weekday>
                        <weekday>Wednesday</weekday>
                        <weekday>Thursday</weekday>
                        <weekday>Friday</weekday>
                        <weekday>Saturday</weekday>
                        <weekday>Sunday</weekday>
                    </day-of-week>
                </recurrence>
            </run-recurring>
        </triggers>
    </job>
</jobs>
